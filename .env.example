# --- Backend server ---
# Port for the Express API. Frontend Vite dev server proxies /api here.
PORT=4000

# --- MongoDB ---
# Local Mongo default: mongodb://localhost:27017/intain_lvc
# For Atlas: mongodb+srv://<user>:<pass>@<cluster>/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/intain_lvc

# --- Auth ---
# Any random 32+ char string. Rotate for production.
JWT_SECRET=change_me

# --- AI Review Assistant ---
# Set AI_ENABLED=true only after AI_API_KEY is populated.
# When false, all AI features fall back to a deterministic reasoner and remain fully demoable.
AI_ENABLED=false
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
